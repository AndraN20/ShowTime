@page "/Artists/{Id:int}"
@using ShowTime.BusinessLogic.Abstractions
@using ShowTime.BusinessLogic.DTOs.Artist
@using ShowTime.BusinessLogic.DTOs.Festival
@inject IArtistService ArtistService
@inject IFestivalService FestivalService
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (artist == null)
{
    <div class="text-center my-5">
        <div class="spinner-border mb-3"></div>
        <div>Loading artist details...</div>
    </div>
}
else
{
    <div class="artist-details-container position-relative">
        <img src="@artist.Image" class="artist-details-image mb-3" alt="@artist.Name" />
        <div class="artist-details-content w-100">
            <h2 class="artist-details-title mb-2">@artist.Name</h2>
            <div class="artist-details-genres mb-3">
                <i class="bi bi-music-note-beamed me-1"></i>
                @artist.Genre
            </div>
        </div>
        <div class="artist-details-festivals w-100 d-flex justify-content-center">
            @if (festivals == null)
            {
                <p>Loading...</p>
            }
            else if (festivals.Count == 0)
            {
                <p>This artist doesn't perform at any festivals yet.</p>
            }
            else
            {
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Date</th>
                            <th>Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fest in festivals.OrderBy(f => f.StartDate))
                        {
                            <tr>
                                <td>
                                    <a href="@($"/Festivals/{fest.Id}")" class="fw-bold">
                                        @fest.Name
                                    </a>
                                </td>
                                <td>
                                    @fest.StartDate.ToShortDateString()
                                </td>
                                <td>
                                    @fest.Location
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private ArtistGetDto? artist;
    private IList<FestivalGetDto>? festivals;

    protected override async Task OnInitializedAsync()
    {
        artist = await ArtistService.GetArtistByIdAsync(Id);
        festivals = await FestivalService.GetFestivalsForArtistAsync(Id);
    }

    private async Task DeleteArtist()
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this artist?");
        if (!confirm)
            return;

        await ArtistService.DeleteArtistAsync(Id);
        Navigation.NavigateTo("/artists");
    }
}
