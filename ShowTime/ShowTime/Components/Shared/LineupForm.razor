@using ShowTime.BusinessLogic.Abstractions
@using ShowTime.BusinessLogic.DTOs.Lineup
@using ShowTime.BusinessLogic.DTOs.Artist
@inject ILineupService LineupService

<EditForm Model="Lineup" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <div class="mb-2">
        <label>Artist</label>
        <InputSelect @bind-Value="Lineup.ArtistId" class="form-control" required>
            <option value="">Select artist</option>
            @foreach (var artist in Artists)
            {
                <option value="@artist.Id">@artist.Name</option>
            }
        </InputSelect>
    </div>
    <div class="mb-2">
        <label>Stage</label>
        <InputSelect @bind-Value="selectedStage" class="form-control" required>
            <option value="">Select stage</option>
            @foreach (var stage in Stages.Distinct())
            {
                <option value="@stage">@stage</option>
            }
            <option value="new"> Add new stage </option>
        </InputSelect>
        @if (selectedStage == "new")
        {
            <input class="form-control mt-2" placeholder="New stage name" @bind="newStage" required />
        }
    </div>
    <div class="mb-2">
        <label>Date & Time</label>
        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Lineup.StartTime" class="form-control" required />
    </div>
    <div class="mb-3 d-flex gap-2">
        <button class="btn btn-primary me-2" type="submit">
            @(ArtistId == null ? "Add to Lineup" : "Save Changes")
        </button>
        @if (OnCancel.HasDelegate)
        {
            <button class="btn btn-secondary" type="button" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
        }
    </div>
</EditForm>

@code {
    [Parameter] public int FestivalId { get; set; }
    [Parameter] public int? ArtistId { get; set; }
    [Parameter] public IList<ArtistGetDto> Artists { get; set; } = new List<ArtistGetDto>();
    [Parameter] public IList<string> Stages { get; set; } = new List<string>();
    [Parameter] public EventCallback<LineupDto> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private LineupDto Lineup = new();
    private string selectedStage = "";
    private string newStage = "";

    protected override async Task OnInitializedAsync()
    {
        if (ArtistId.HasValue)
        {
            var lineup = await LineupService.GetAsync(FestivalId, ArtistId.Value);
            if (lineup != null)
            {
                Lineup = new LineupDto
                {
                    FestivalId = lineup.FestivalId,
                    ArtistId = lineup.ArtistId,
                    Stage = lineup.Stage,
                    StartTime = lineup.StartTime
                };
            }
        }
        else
        {
            Lineup = new LineupDto { FestivalId = FestivalId, StartTime = DateTime.Today.AddHours(18) };
        }
        if (!string.IsNullOrWhiteSpace(Lineup.Stage) && Stages.Contains(Lineup.Stage))
        {
            selectedStage = Lineup.Stage;
        }
        else if (!string.IsNullOrWhiteSpace(Lineup.Stage))
        {
            selectedStage = "new";
            newStage = Lineup.Stage;
        }
    }

    private async Task HandleValidSubmit()
    {
        Lineup.FestivalId = FestivalId;
        if (selectedStage == "new" && string.IsNullOrWhiteSpace(newStage))
            return;
        Lineup.Stage = selectedStage == "new" ? newStage.Trim() : selectedStage;
        await OnSave.InvokeAsync(Lineup);
    }
}
