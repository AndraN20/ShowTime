@page "/Festivals"
@using ShowTime.BusinessLogic.Abstractions
@using ShowTime.BusinessLogic.DTOs.Festival
@inject IFestivalService FestivalService
@using ShowTime.Components.Shared
@rendermode InteractiveServer

<h3>Festivals</h3>
<AuthorizeView Roles="Administrator">
    <button class="btn btn-success mb-3" @onclick="ShowAddForm">
        <i class="bi bi-plus-circle" style="font-size: 1.2rem;"></i>
    </button>
</AuthorizeView>

@if (showAddForm)
{
    <div class="form-drawer show">
        <div class="form-drawer-header">
            <span class="form-drawer-title">Add Festival</span>
            <button class="form-drawer-toggle" @onclick="() => showAddForm = false">
                <i class="bi bi-chevron-up"></i>
            </button>
        </div>
        <FestivalForm OnSave="HandleSaveFestival" />
    </div>
}

@if (editFestivalId != null)
{
    <div class="form-drawer show">
        <div class="form-drawer-header">
            <span class="form-drawer-title">Edit Festival</span>
            <button class="form-drawer-toggle" @onclick="() => editFestivalId = null">
                <i class="bi bi-chevron-up"></i>
            </button>
        </div>
        <FestivalForm FestivalId="@editFestivalId" OnSave="HandleSaveFestival" />
    </div>
}

@if (festivals.Count == 0)
{
    <p>No festivals yet.</p>
}
else
{
    <div class="mb-3 d-flex align-items-center gap-2 genre-filter-row">
        <label class="mb-0 filter-label">Filter by location:</label>
        <select @bind="selectedLocation" @bind:event="onchange" class="filter-select">
            <option value="">All Locations</option>
            @foreach (var loc in allLocations)
            {
                <option value="@loc">@loc</option>
            }
        </select>
    </div>

    <QuickGrid TGridItem="FestivalGetDto"
               Items="FilteredFestivals"
               Table-Classes="table table-hover quickgrid-table align-middle table-striped border shadow rounded-3"
               Sortable="true">
        <TemplateColumn Title="Image" Context="festival">
            <a href="@($"/Festivals/{festival.Id}")" style="display:inline-block">
                <img src="@festival.SplashArt"
                     alt="@festival.Name"
                     class="rounded-4 shadow festival-img"
                     style="height: 200px; width:auto; object-fit: cover; background: transparent;" />
            </a>
        </TemplateColumn>

        <PropertyColumn Property="f => f.Name" Sortable="true" Title="Name" />

        <TemplateColumn Title="Location" Context="festival">
            <span class="badge bg-info bg-opacity-75 me-1">@festival.Location</span>
        </TemplateColumn>

        <TemplateColumn Title="Dates" Context="festival">
            <span>@festival.StartDate.ToShortDateString() – @festival.EndDate.ToShortDateString()</span>
        </TemplateColumn>

        <TemplateColumn Title="Actions" Context="festival">
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <button class="btn btn-sm btn-outline-primary me-2" title="Edit"
                            @onclick="() => EditFestival(festival.Id)">
                        <i class="bi bi-pencil"></i>
                    </button>
                </Authorized>
            </AuthorizeView>
        </TemplateColumn>

    </QuickGrid>
}

@code {
    private IList<FestivalGetDto> festivals = new List<FestivalGetDto>();
    private IList<string> allLocations = new List<string>();
    private bool showAddForm = false;
    private int? editFestivalId = null;
    private string selectedLocation = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadFestivals();
    }

    private async Task LoadFestivals()
    {
        festivals = await FestivalService.GetAllFestivalsAsync();
        allLocations = festivals.Select(f => f.Location).Where(l => !string.IsNullOrWhiteSpace(l)).Distinct().ToList();
    }

    private IQueryable<FestivalGetDto> FilteredFestivals =>
        string.IsNullOrEmpty(selectedLocation)
            ? festivals.AsQueryable()
            : festivals.Where(f => f.Location == selectedLocation).AsQueryable();

    private void ShowAddForm()
    {
        showAddForm = true;
        editFestivalId = null;
    }

    private void EditFestival(int id)
    {
        showAddForm = false;
        editFestivalId = id;
    }

    private async Task HandleSaveFestival(FestivalCreateDto festival)
    {
        if (editFestivalId == null)
            await FestivalService.CreateFestivalAsync(festival);
        else
            await FestivalService.UpdateFestivalAsync(editFestivalId.Value, new FestivalUpdateDto
            {
                Name = festival.Name,
                Location = festival.Location,
                StartDate = festival.StartDate,
                EndDate = festival.EndDate,
                SplashArt = festival.SplashArt
            });

        showAddForm = false;
        editFestivalId = null;
        await LoadFestivals();
        StateHasChanged();
    }
}
