@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using ShowTime.BusinessLogic.Abstractions
@using ShowTime.BusinessLogic.DTOs
@using ShowTime.BusinessLogic.DTOs.User
@using ShowTime.BusinessLogic.DTOs.Booking
@inject IUserService UserService
@inject IBookingService BookingService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@attribute [Authorize]
@rendermode InteractiveServer

@if (loading)
{
    <div class="text-center my-5">
        <div class="spinner-border mb-3"></div>
        <div>Loading profile...</div>
    </div>
}
else if (currentUser != null)
{
    <div class="profile-card">
        <h3 class="mb-3">Profile</h3>
        <div class="profile-info mb-4">
            <div><b>Email:</b> @currentUser.Email</div>
            <div><b>Role:</b> @currentUser.Role.ToString()</div>
            <button class="btn btn-outline-secondary mb-3 float-end" @onclick="Logout">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
        </div>

        <h4>My Bookings</h4>
        @if (myBookings.Count == 0)
        {
            <p>No bookings yet.</p>
        }
        else
        {
            <ul class="list-group mb-4">
                @foreach (var booking in myBookings)
                {
                    <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                        <div>
                            <b>Festival ID: @booking.FestivalId</b> |
                            @booking.Type x
                            @if (editingFestivalId == booking.FestivalId && editingUserId == booking.UserId)
                            {
                                <input type="number" min="1" class="form-control d-inline-block" style="width:80px;" @bind="editQuantity" />
                                <button class="btn btn-sm btn-success ms-1" @onclick="() => SaveQuantity(booking.FestivalId, booking.UserId)">
                                    <i class="bi bi-check"></i>
                                </button>
                                <button class="btn btn-sm btn-secondary ms-1" @onclick="CancelEdit">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                            else
                            {
                                @booking.Quantity
                                <button class="btn btn-sm btn-outline-primary ms-1"
                                        @onclick="() => StartEdit(booking.FestivalId, booking.UserId, booking.Quantity)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            }
                            , total: <b>@booking.Price RON</b>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteBooking(booking.FestivalId, booking.UserId)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </li>
                }

            </ul>
        }

        @if (isAdmin)
        {
            <h4 class="mt-4 mb-3">All Users</h4>
            <table class="table profile-users-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in allUsers)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Email</td>
                            <td>@user.Role.ToString()</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="@(() => DeleteUser(user.Id))">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else
{
    <div class="alert alert-danger">User not found.</div>
}

@code {
    private UserGetDto? currentUser;
    private IList<BookingGetDto> myBookings = new List<BookingGetDto>();
    private IList<UserGetDto> allUsers = new List<UserGetDto>();
    private bool isAdmin = false;
    private bool loading = true;
    private string errorMessage = "";

    private int editingFestivalId = 0;
    private int editingUserId = 0;
    private int editQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var email = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value;
        if (email != null)
        {
            currentUser = await UserService.GetUserByEmailAsync(email);
            isAdmin = currentUser?.Role.ToString() == "Administrator";
            if (currentUser != null)
            {
                myBookings = await BookingService.GetBookingsForUserAsync(currentUser.Id);
            }
            if (isAdmin)
            {
                allUsers = await UserService.GetAllUsersAsync();
            }
        }
        loading = false;
    }

    private async Task DeleteBooking(int festivalId, int userId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Delete this booking?");
        if (!confirm) return;
        await BookingService.DeleteBookingAsync(festivalId, userId);
        if (currentUser != null)
            myBookings = await BookingService.GetBookingsForUserAsync(currentUser.Id);
        StateHasChanged();
    }

    private void StartEdit(int festivalId, int userId, int currentQuantity)
    {
        editingFestivalId = festivalId;
        editingUserId = userId;
        editQuantity = currentQuantity;
    }

    private void CancelEdit()
    {
        editingFestivalId = 0;
        editingUserId = 0;
        editQuantity = 1;
    }

    private async Task SaveQuantity(int festivalId, int userId)
    {
        if (editQuantity < 1)
        {
            await JS.InvokeVoidAsync("alert", "Quantity must be at least 1.");
            return;
        }
        try
        {
            var updated = await BookingService.UpdateBookingQuantityAsync(festivalId, userId, editQuantity);
            var idx = myBookings.ToList().FindIndex(b => b.FestivalId == festivalId && b.UserId == userId);
            if (idx >= 0)
                myBookings[idx] = updated;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        editingFestivalId = 0;
        editingUserId = 0;
    }

    private async Task DeleteUser(int userId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Delete this user?");
        if (!confirm) return;
        await UserService.DeleteUserAsync(userId);
        allUsers = await UserService.GetAllUsersAsync();
        StateHasChanged();
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }
}
