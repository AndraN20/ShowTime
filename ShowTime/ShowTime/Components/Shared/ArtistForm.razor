@using ShowTime.BusinessLogic.Abstractions
@using ShowTime.BusinessLogic.DTOs.Artist
@inject IJSRuntime JS
@inject IArtistService ArtistService

<EditForm Model="Artist" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Artist Name</label>
        <InputText @bind-Value="Artist.Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Artist Image URL</label>
        <InputText @bind-Value="Artist.Image" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Select Genre</label>
        <div class="input-group">
            <select class="form-select" @bind="Artist.Genre">
                <option value="">Choose genre...</option>
                @foreach (var g in AllGenres)
                {
                    <option value="@g">@g</option>
                }
            </select>
            <input type="text" class="form-control" placeholder="Add new genre" @bind="newGenreName" />
            <button type="button" class="btn btn-secondary" @onclick="AddNewGenre" disabled="@isAddingGenre">
                @(isAddingGenre ? "Adding..." : "Add")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(addGenreError))
    {
        <div class="alert alert-danger py-1 px-2 small">@addGenreError</div>
    }

    <div class="mb-3">
        <label>Genres List:</label>
        <ul class="list-group">
            @foreach (var g in AllGenres)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center p-1">
                    <span>@g</span>
                </li>
            }
        </ul>
    </div>

    <button type="submit" class="btn btn-primary">
        @(ArtistId == null ? "Add Artist" : "Save Changes")
    </button>
</EditForm>

@code {
    [Parameter] public int? ArtistId { get; set; }
    [Parameter] public EventCallback<ArtistCreateDto> OnSave { get; set; }
    [Parameter] public IList<string> Genres { get; set; } = new List<string>();

    private IList<string> AllGenres = new List<string>();
    private ArtistCreateDto Artist = new();
    private string? newGenreName;
    private string? addGenreError;
    private bool isAddingGenre = false;

    protected override async Task OnParametersSetAsync()
    {
        AllGenres = Genres?.ToList() ?? new List<string>();

        if (ArtistId.HasValue)
        {
            var artist = await ArtistService.GetArtistByIdAsync(ArtistId.Value);
            Artist = new ArtistCreateDto
            {
                Name = artist.Name,
                Image = artist.Image,
                Genre = artist.Genre,
            };
        }
        else
        {
            Artist = new ArtistCreateDto();
        }
    }

    private void AddNewGenre()
    {
        addGenreError = null;
        if (string.IsNullOrWhiteSpace(newGenreName)) return;

        isAddingGenre = true;
        try
        {
            var genreTrimmed = newGenreName.Trim();
            if (!AllGenres.Contains(genreTrimmed, StringComparer.OrdinalIgnoreCase))
            {
                AllGenres.Add(genreTrimmed);
                AllGenres = AllGenres.OrderBy(g => g).ToList();
            }
            Artist.Genre = genreTrimmed;
            newGenreName = "";
        }
        catch (Exception ex)
        {
            addGenreError = "Could not add genre: " + ex.Message;
        }
        finally
        {
            isAddingGenre = false;
            StateHasChanged();
        }
    }

    private Task HandleValidSubmit() => OnSave.InvokeAsync(Artist);
}
