@page "/register"
@using ShowTime.BusinessLogic.Abstractions
@using ShowTime.BusinessLogic.DTOs.User
@inject IUserService UserService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="d-flex align-items-center justify-content-center vh-100">
    <div class="card p-4 shadow" style="min-width:340px; border-radius:20px;">
        <h2 class="mb-4 text-center">Create Account</h2>
        <EditForm Model="RegisterInfo" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Email</label>
                <InputText @bind-Value="RegisterInfo.Email" placeholder="Email" class="form-control" /><br />
                <ValidationMessage For="@(() => RegisterInfo.Email)" />
            </div>
            <div class="mb-3">
                <label>Password</label>
                <InputText @bind-Value="RegisterInfo.Password" type="password" placeholder="Password" class="form-control" /><br />
                <ValidationMessage For="@(() => RegisterInfo.Password)" />
            </div>
            <div class="mb-3">
                <label>Confirm Password</label>
                <InputText @bind-Value="RegisterInfo.ConfirmPassword" class="form-control" type="password" />
                <ValidationMessage For="@(() => RegisterInfo.ConfirmPassword)" />
            </div>

            <button class="btn btn-success w-100" type="submit">Register</button>
        </EditForm>
        <div class="text-center mt-3">
            <span>Already have an account?</span>
            <a href="/login" class="ms-1">Sign in</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mt-3 text-center">@errorMessage</div>
        }
    </div>
</div>

@code {
    private UserCreateDto RegisterInfo { get; set; } = new UserCreateDto();
    private string errorMessage = "";

    private async Task HandleRegister()
    {
        Console.WriteLine($"Email: {RegisterInfo.Email}, Pass: {RegisterInfo.Password}, Confirm: {RegisterInfo.ConfirmPassword}");
        try
        {
            
            errorMessage = "";
            await UserService.CreateUserAsync(RegisterInfo);
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = ex.InnerException?.Message ?? ex.Message;
        }
    }
}
